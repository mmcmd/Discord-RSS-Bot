# Copy to .env and fill in. DATA_DIR is set by the image (/data); do not set it here.

# Required. The bot token from the Discord developer portal.
DISCORD_TOKEN=

# Optional. Allow feed URLs that resolve to private or local addresses. Default: false.
# Accepted as true: 1, true, yes, on.
ALLOW_PRIVATE_URLS=false

# Optional. How much the bot writes to the container log (docker compose logs rssbot).
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL. Default: INFO.
#   INFO    start-up, changes, commands, Checks that posted Items; quiet otherwise.
#   WARNING only trouble: failed Checks, skipped Items, failed deliveries.
#   DEBUG   every Check, fetch and delivery; busy, for finding out why a Feed misbehaves.
# Feed addresses and tokens are never written, whatever the level.
LOG_LEVEL=INFO
